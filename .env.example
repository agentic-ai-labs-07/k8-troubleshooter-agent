# Copy to .env and fill in. Docker Compose reads .env. Git and the image build skip it.
# The default is the live model, which needs OPENAI_API_KEY. Set AGENT_MODEL=rules to run without a key.

# live (default, calls the model below) or rules (rule-based stand-in, no API key, no network).
AGENT_MODEL=live

# Required only when AGENT_MODEL=live. Keep the line even when empty: Compose needs it to start.
# The agent gets it as the file /run/secrets/openai_api_key, not as an environment variable.
# To keep it off disk, leave it empty here and run `read -rs OPENAI_API_KEY && export OPENAI_API_KEY`.
OPENAI_API_KEY=

# Optional. Empty means gpt-4.1-mini. Use a model your key's project allows.
OPENAI_MODEL=gpt-4.1-mini
# Optional. Any OpenAI-compatible endpoint. Empty means api.openai.com.
OPENAI_BASE_URL=

# The stopping condition: the most model steps per run, and the most tokens per model reply.
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=1024

# Linux only: your `id -u`, so the non-root container can read .kube/ and write traces/. Empty means 10001.
HOST_UID=

# Log lines on stderr while the agent runs: one event per step. INFO shows each step. DEBUG adds what each step returned.
LOG_LEVEL=INFO
# On screen: text for people, json for one JSON object per line (for a log collector).
# Either way, every line is also saved as JSON in traces/logs/. Read them with `logs`.
LOG_FORMAT=text
